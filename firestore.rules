rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'vedanth.suresh039@gmail.com';
    }

    // Helper function to check if user owns the booking
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ==================== UNITS ====================
    // Units are publicly readable, only admin can write
    match /units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== MODULES ====================
    // Modules are publicly readable, only admin can write
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== TIME SLOTS ====================
    // Time slots are publicly readable
    match /time_slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== BOOKINGS ====================
    match /bookings/{bookingId} {
      // Allow creating bookings (authenticated or guest)
      // Note: Capacity validation must be done client-side with transactions
      allow create: if request.resource.data.student_email is string &&
                    request.resource.data.student_name is string &&
                    request.resource.data.student_phone is string &&
                    request.resource.data.student_age >= 6 &&
                    request.resource.data.student_age <= 18;

      // Users can read their own bookings
      allow read: if isOwner(request.resource.data.user_id) ||
                  isAdmin();

      // Users can update their own booking (e.g., cancel)
      allow update: if isOwner(request.resource.data.user_id) &&
                     (request.resource.data.status == 'cancelled' ||
                      resource.data.status == request.resource.data.status);

      // Only admin can delete bookings
      allow delete: if isAdmin();
    }

    // ==================== USERS (for Firebase Auth user data) ====================
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile on registration
      allow create: if isOwner(userId);

      // Users can update their own profile
      allow update: if isOwner(userId);

      // Only admin can delete
      allow delete: if isAdmin();
    }
  }
}
